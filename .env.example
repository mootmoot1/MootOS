# MootOS Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control - it is excluded via .gitignore

# AI Model Configuration
# The v0.1 router currently supports openai. Local providers are planned.
AI_PROVIDER=openai

# OpenAI API Configuration
# Required when AI_PROVIDER=openai.
OPENAI_API_KEY=your_api_key_here
# Cost-conscious default for the first conversation loop.
OPENAI_MODEL=gpt-5-mini

# Local Model Configuration (future)
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama2

# Application Configuration
APP_ENV=development
APP_DEBUG=false
# APP_DEBUG options: true, false (set to true only during development)

# Security
# Use strong random strings in production
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256

# Database
DATABASE_URL=sqlite:///./moot_os.db
# For production, consider: postgresql://user:password@localhost/mootosdb

# Logging
LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/moot_os.log

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Settings (for frontend access)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Memory Configuration
MEMORY_BACKEND=sqlite
# MEMORY_BACKEND options: sqlite, json (file-based for now, vector DB later)

# Cloud Budget (in USD, for cost control)
MAX_MONTHLY_CLOUD_BUDGET=50.00
MAX_DAILY_CLOUD_BUDGET=5.00

# User Configuration Defaults
DEFAULT_PROJECT=Personal
DEFAULT_TIMEZONE=America/New_York

# Tool Permissions (defaults)
# Set to true to allow tool usage, false to require approval
ALLOW_FILE_READ=true
ALLOW_FILE_WRITE=false
ALLOW_WEB_SEARCH=false
ALLOW_GITHUB_READ=false
ALLOW_GITHUB_WRITE=false
