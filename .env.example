# MootOS Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env or real secret values.

# AI model configuration
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Private phone deployment
# Set both values together in Railway. Leave both blank for open local development.
MOOTOS_PASSWORD=choose_a_strong_private_password
MOOTOS_SESSION_SECRET=generate_a_long_random_secret

# High-risk Railway override.
# Railway refuses to start without private auth unless this is explicitly true.
# Leave false for normal MootOS production.
MOOTOS_ALLOW_PUBLIC=false

# Optional local override. Railway automatically enables secure cookies.
MOOTOS_SECURE_COOKIES=false

# Optional SQLite path override for local development.
# Normal Railway production must use RAILWAY_VOLUME_MOUNT_PATH.
# MOOTOS_DATABASE_PATH=/absolute/path/to/mootos.db

# Separate high-risk Railway database-path override.
# Leave false in normal production. Setting true permits an absolute
# MOOTOS_DATABASE_PATH outside the attached Railway volume.
MOOTOS_ALLOW_UNSAFE_DATABASE_PATH=false

# Future local model configuration
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama2
